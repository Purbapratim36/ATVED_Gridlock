# =============================================================================
# ATVED Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to version control.
# =============================================================================

# --- Application ---
ATVED_ENV=development
ATVED_DEBUG=true
ATVED_LOG_LEVEL=DEBUG
ATVED_SECRET_KEY=change-me-to-a-random-64-char-string

# --- Database (PostgreSQL + PostGIS) ---
ATVED_DB_HOST=localhost
ATVED_DB_PORT=5432
ATVED_DB_NAME=atved
ATVED_DB_USER=atved
ATVED_DB_PASSWORD=change-me
ATVED_DB_POOL_SIZE=20
ATVED_DB_MAX_OVERFLOW=10

# --- Redis ---
ATVED_REDIS_URL=redis://localhost:6379/0

# --- Kafka ---
ATVED_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ATVED_KAFKA_TOPIC_FRAMES=camera-frames
ATVED_KAFKA_TOPIC_VIOLATIONS=violation-events
ATVED_KAFKA_CONSUMER_GROUP=inference-workers

# --- Object Storage (S3/MinIO) ---
ATVED_S3_ENDPOINT=http://localhost:9000
ATVED_S3_ACCESS_KEY=minioadmin
ATVED_S3_SECRET_KEY=minioadmin
ATVED_S3_BUCKET_EVIDENCE=atved-evidence
ATVED_S3_BUCKET_RAW=atved-raw-frames
ATVED_S3_REGION=us-east-1

# --- Encryption ---
ATVED_ENCRYPTION_KEY=change-me-base64-encoded-32-byte-key
ATVED_ENCRYPTION_ALGORITHM=AES-256-GCM

# --- JWT / Auth ---
ATVED_JWT_SECRET=change-me-to-a-random-string
ATVED_JWT_ALGORITHM=HS256
ATVED_JWT_EXPIRY_MINUTES=60

# --- Model Paths ---
ATVED_MODEL_DETECTION=models/detection/yolov8l.pt
ATVED_MODEL_PLATE_DETECT=models/plate_ocr/plate_detector.pt
ATVED_MODEL_PLATE_OCR=models/plate_ocr/paddleocr
ATVED_MODEL_TAMPER_DETECT=models/tamper_detection/tamper_mobilenetv3.pt
ATVED_MODEL_HELMET_CLASSIFIER=models/violations/helmet_classifier.pt
ATVED_MODEL_SEATBELT_CLASSIFIER=models/violations/seatbelt_classifier.pt

# --- Inference ---
ATVED_DEVICE=cuda:0
ATVED_BATCH_SIZE=16
ATVED_DETECTION_CONFIDENCE=0.5
ATVED_NMS_THRESHOLD=0.45

# --- Retention Policy ---
ATVED_RETENTION_VIOLATION_DAYS=365
ATVED_RETENTION_NON_VIOLATION_HOURS=72
ATVED_RETENTION_RAW_BUFFER_HOURS=24
ATVED_RETENTION_AUDIT_LOG_YEARS=7

# --- Observability ---
ATVED_OTEL_ENDPOINT=http://localhost:4317
ATVED_PROMETHEUS_PORT=9090
